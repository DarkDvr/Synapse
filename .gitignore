# Runtime state - regenerated on start
data/
logs/
# (the projects root is a sibling of this folder, so it needs no entry here)

# Node
node_modules/
npm-debug.log*

# The runtime, copied in by vendor-engine.ps1. A 200 MB binary is not something to
# carry in history: it travels with the folder, and the script can restore it.
bin/

# .NET build output (a project or the template)
obj/
