# Runtime state - regenerated on start
data/
logs/
.synapse/
# (the projects root is a sibling of this folder, so it needs no entry here)

# Local design references and mockups - kept on the machine, not in the repository
/references/
docs/*.pdf

# The app. shell\build.ps1 makes it, it travels with the folder, and one exe at the
# root is the whole launcher - not something to carry in history.
Synapse.exe
Synapse.pdb
Synapse.exe.WebView2/
shell/dist/
# the local deliverable zip
Synapse.zip

# Node
node_modules/
npm-debug.log*

# The runtime, copied in by vendor-engine.ps1. A 200 MB binary is not something to
# carry in history: it travels with the folder, and the script can restore it.
bin/
# ...but the app-check skill keeps its two tools in a `bin` folder, and those are
# source: they are the skill, not build output. Without this line the rule above
# sweeps them out of the repository.
!skills/app-check/bin/

# .NET build output (a project or the template)
obj/

# local build output
dist/

# Vendored build caches (vendor-node.ps1, vendor-nuget.ps1) - they travel with the folder
vendor/
