<Window x:Class="Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="App"
        Width="1080" Height="720"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#12120F"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <!-- One control. Everything the operator sees is drawn by ui/, in the same
       engine Synapse's own screenshots use, so what the Designer reviewed is
       what runs here. -->
  <wv2:WebView2 x:Name="View" DefaultBackgroundColor="#12120F" />
</Window>
